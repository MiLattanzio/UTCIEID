# Optional, app-specific access for full-PIN storage through libsecret.
# This is not part of Ubuntu Touch's standard Click policy groups.
# No direct access to keyring files or any other application's files.
# libsecret addresses the owner's unique bus name, so match interface/path/label rather than a well-known destination.
  dbus (send)
       bus=session
       path=/org/freedesktop/secrets{,/**}
       interface=org.freedesktop.Secret.{Service,Collection,Item,Session,Prompt}
       peer=(label=unconfined),
  dbus (send)
       bus=session
       path=/org/freedesktop/secrets{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll}
       peer=(label=unconfined),
  dbus (receive)
       bus=session
       path=/org/freedesktop/secrets{,/**}
       interface=org.freedesktop.Secret.{Service,Collection,Item,Session,Prompt}
       peer=(label=unconfined),
  dbus (receive)
       bus=session
       path=/org/freedesktop/secrets{,/**}
       interface=org.freedesktop.DBus.Properties
       member=PropertiesChanged
       peer=(label=unconfined),
